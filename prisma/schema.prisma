generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum MovementType {
  IN
  OUT
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  challans  SalesChallan[]
  movements StockMovement[]
}

model Customer {
  id           Int            @id @default(autoincrement())
  name         String
  mobile       String
  email        String?
  businessName String
  gstNumber    String?
  type         CustomerType
  address      String
  status       CustomerStatus
  followUpDate DateTime?
  notes        String?

  challans SalesChallan[]
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  sku          String   @unique
  category     String
  unitPrice    Float
  currentStock Int
  minimumStock Int
  location     String
  createdAt    DateTime @default(now())

  movements StockMovement[]
  items     SalesChallanItem[]
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  quantity  Int
  type      MovementType
  reason    String
  createdAt DateTime     @default(now())
  createdBy Int

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [createdBy], references: [id])
}

model SalesChallan {
  id            Int           @id @default(autoincrement())
  challanNumber String        @unique
  customerId    Int
  totalQuantity Int
  status        ChallanStatus
  createdAt     DateTime      @default(now())
  createdBy     Int

  customer Customer           @relation(fields: [customerId], references: [id])
  user     User               @relation(fields: [createdBy], references: [id])
  items    SalesChallanItem[]
}

model SalesChallanItem {
  id             Int    @id @default(autoincrement())
  salesChallanId Int
  productId      Int
  productName    String
  quantity       Int
  unitPrice      Float

  challan SalesChallan @relation(fields: [salesChallanId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
}
